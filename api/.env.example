# Server
PORT=3000
NODE_ENV=development

# CORS (URL do frontend, separadas por vírgula se houver mais de uma)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
# Railway/produção: use a URL interna do serviço Postgres
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=beauty_express
DB_SYNCHRONIZE=true
DB_LOGGING=false
# DB_SSL=true
# Em produção: DB_SYNCHRONIZE=false e rode migrations antes do start
# DB_MIGRATIONS_RUN=true  # opcional: aplica migrations ao subir a API

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limit nos logins (por IP)
THROTTLE_LOGIN_LIMIT=10
THROTTLE_LOGIN_TTL_MS=60000

# WhatsApp / Evolution API (atendimento, não oficial)
# URL base da Evolution API e apikey global dela
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me-evolution-apikey
# URL pública desta API para a Evolution entregar os webhooks
# (ex.: em dev use um túnel; em prod a URL pública da API)
EVOLUTION_WEBHOOK_PUBLIC_URL=http://localhost:3000
# Token secreto validado no webhook (?token=...) para evitar chamadas forjadas
EVOLUTION_WEBHOOK_TOKEN=change-me-webhook-token

# Rate limit de ENVIO de WhatsApp por tenant (protege o número contra ban)
WHATSAPP_SEND_LIMIT=20
WHATSAPP_SEND_WINDOW_MS=60000

# Storage de mídia das mensagens de WhatsApp
# driver: "inline" (base64 no banco, só dev) ou "s3" (recomendado em produção)
MEDIA_STORAGE_DRIVER=inline
# TTL opcional: aplica lifecycle de expiração dos objetos no bucket (em dias)
# MEDIA_TTL_DAYS=30
# Limite de tamanho por arquivo de mídia baixado (MB). 0 = sem limite. Default 16.
# WHATSAPP_MEDIA_MAX_MB=16
# Credenciais do bucket (necessárias quando MEDIA_STORAGE_DRIVER=s3)
# Ex.: bucket S3-compatível do Railway/MinIO
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=https://seu-endpoint-s3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=https://cdn-ou-endpoint-publico
